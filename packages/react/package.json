{
  "name": "@qhkg/react",
  "version": "0.5.0",
  "description": "Accessible React components for the QH Design System",
  "license": "MIT",
  "homepage": "https://design.qihao.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qihaokaigong/qh-design.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/qihaokaigong/qh-design/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "skills"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./components.css": "./dist/components.css",
    "./theme.css": "./dist/theme.css",
    "./*.css": "./dist/component-styles/*.css",
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/finalize-css.mjs",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:bundle": "node scripts/verify-bundle.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@qhkg/tokens": "workspace:^",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.47.0",
    "radix-ui": "1.6.7",
    "react-aria-components": "1.21.1"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "happy-dom": "20.14.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "rollup-preserve-directives": "1.1.3",
    "storybook": "10.6.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
