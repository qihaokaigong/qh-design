{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "qh-design-mcp",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "design.qihao.dev/mcp*",
      "zone_name": "qihao.dev",
    },
  ],
  "vars": {
    "STORYBOOK_ORIGIN": "https://qh-design.pages.dev",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
    },
  },
}
