{
  "name": "qh-design-system",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "ai:docs": "node scripts/generate-ai-docs.mjs",
    "build": "pnpm ai:docs && pnpm registry:build && turbo run build",
    "changeset": "changeset",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "turbo run dev --parallel",
    "e2e:prepare": "pnpm ai:docs && pnpm registry:build && turbo run build --filter=@qh-design/react",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "registry:build": "shadcn build registry/registry.json --output apps/storybook/public/r",
    "release": "pnpm check && pnpm release:verify && pnpm release:packages",
    "release:packages": "changeset publish",
    "release:verify": "node scripts/verify-release.mjs",
    "storybook": "pnpm --filter @qh-design/storybook storybook",
    "storybook:build": "pnpm --filter @qh-design/storybook build",
    "test": "turbo run test",
    "test:e2e": "pnpm e2e:prepare && playwright test --config e2e/playwright.config.ts",
    "version-packages": "changeset version && pnpm registry:sync-version && pnpm registry:build && pnpm ai:docs",
    "registry:sync-version": "node scripts/sync-registry-version.mjs",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.63.0",
    "@qh-design/react": "workspace:*",
    "@storybook/react-vite": "10.6.0",
    "@types/node": "22.20.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "ajv": "8.20.0",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.6.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.0",
    "storybook": "10.6.0",
    "turbo": "2.10.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
